#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
RecalboxGUI - Preparación de dependencias

USO
    bin/setup --install [--yes]
    bin/setup --check

OPCIONES
    --install   Instala dependencias y prepara el entorno privado.
    --check     Comprueba el sistema sin realizar cambios.
    --yes       Omite la confirmación previa a instalar paquetes.
    --help, -h  Muestra esta ayuda.
EOF
}

ACTION=""
ASSUME_YES=0
progress() { printf '[RecalboxGUI setup] %s\n' "$1"; }

for argument in "$@"; do
    case "$argument" in
        --install|--check)
            requested_action="${argument#--}"
            if [[ -n "$ACTION" && "$ACTION" != "$requested_action" ]]; then
                printf 'No se pueden combinar --install y --check.\n\n' >&2
                usage >&2
                exit 2
            fi
            ACTION="$requested_action"
            ;;
        --yes) ASSUME_YES=1 ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'Opción desconocida: %s\n\n' "$argument" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$ACTION" ]]; then usage; exit 0; fi
if [[ "$ACTION" != install && "$ASSUME_YES" -eq 1 ]]; then
    printf 'La opción --yes solo puede utilizarse con --install.\n\n' >&2
    usage >&2
    exit 2
fi

progress 'Comprobando la versión de Bash...'
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
    printf 'Se necesita Bash 4.2 o posterior. Versión actual: %s\n' "$BASH_VERSION" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd -P)"
VENV_DIR="$PROJECT_DIR/gui/.venv"
VENV_PYTHON="$VENV_DIR/bin/python"
EGG_INFO_DIR="$PROJECT_DIR/recalboxgui.egg-info"
DISTRO_ID="unknown"
DISTRO_LIKE=""
DISTRO_NAME="Distribución Linux desconocida"
PACKAGE_FAMILY="unknown"
PACKAGES=()
MISSING_PACKAGES=()
ELEVATE=()

cleanup_project_metadata() {
    if [[ -d "$EGG_INFO_DIR" ]]; then
        rm -rf -- "$EGG_INFO_DIR"
    fi
}
trap cleanup_project_metadata EXIT

progress "Raíz del proyecto: $PROJECT_DIR"
progress 'Detectando la distribución Linux...'
if [[ -r /etc/os-release ]]; then
    source /etc/os-release
    DISTRO_ID="${ID:-unknown}"
    DISTRO_LIKE="${ID_LIKE:-}"
    DISTRO_NAME="${PRETTY_NAME:-$DISTRO_ID}"
fi

distribution_matches() {
    local candidate="$1"
    [[ " $DISTRO_ID $DISTRO_LIKE " == *" $candidate "* ]]
}

if distribution_matches debian || distribution_matches ubuntu; then
    PACKAGE_FAMILY=apt
    PACKAGES=(
        # Python, transporte remoto y creación de paquetes distribuibles.
        python3 python3-venv openssh-client zip gvfs-backends libgl1 libegl1 libfontconfig1 libdbus-1-3
        # Backend gráfico X11/XCB requerido por PySide6/Qt en Linux.
        libx11-6 libx11-xcb1 libxcb1 libxcb-cursor0 libxcb-icccm4
        libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0
        libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-xfixes0
        libxcb-xinerama0 libxcb-xkb1 libxkbcommon0 libxkbcommon-x11-0
    )
elif distribution_matches fedora || distribution_matches rhel; then
    PACKAGE_FAMILY=dnf
    PACKAGES=(
        # Python, transporte remoto, empaquetado y runtime gráfico de Qt.
        python3 openssh-clients zip gvfs-smb mesa-libGL mesa-libEGL fontconfig dbus-libs libX11
        libX11-xcb libxcb xcb-util-cursor xcb-util-wm xcb-util-image
        xcb-util-keysyms xcb-util-renderutil libxkbcommon libxkbcommon-x11
    )
elif distribution_matches arch; then
    PACKAGE_FAMILY=pacman
    PACKAGES=(
        # Python, transporte remoto, empaquetado y runtime gráfico de Qt.
        python openssh zip gvfs-smb mesa fontconfig dbus libx11 libxcb xcb-util-cursor
        xcb-util-wm xcb-util-image xcb-util-keysyms xcb-util-renderutil
        libxkbcommon libxkbcommon-x11
    )
elif distribution_matches suse || distribution_matches opensuse; then
    PACKAGE_FAMILY=zypper
    PACKAGES=(
        # Python, transporte remoto, empaquetado y runtime gráfico de Qt.
        python3 python3-pip python3-virtualenv openssh-clients zip gvfs-backend-samba Mesa-libGL1 Mesa-libEGL1
        fontconfig libdbus-1-3 libX11-6 libX11-xcb1 libxcb1 libxcb-cursor0
        xcb-util-wm xcb-util-image xcb-util-keysyms xcb-util-renderutil
        libxkbcommon0 libxkbcommon-x11-0
    )
fi

progress "Sistema detectado: $DISTRO_NAME"

show_manual_requirements() {
    cat <<EOF

La instalación automática no está disponible para: $DISTRO_NAME

Instala Python 3.10+ con venv y pip, OpenSSH y las bibliotecas
OpenGL/EGL, fontconfig, D-Bus, X11/XCB y xkbcommon. Después ejecuta:
  $SCRIPT_DIR/setup --install
EOF
}

package_installed() {
    local package="$1"
    case "$PACKAGE_FAMILY" in
        apt) dpkg-query -W -f='${Status}\n' "$package" 2>/dev/null | grep -qx 'install ok installed' ;;
        dnf|zypper) rpm -q --quiet "$package" >/dev/null 2>&1 ;;
        pacman) pacman -Qq "$package" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}

install_packages() {
    case "$PACKAGE_FAMILY" in
        apt)
            progress 'Actualizando el índice de APT...'
            "${ELEVATE[@]}" apt-get update
            "${ELEVATE[@]}" apt-get install -y -- "${MISSING_PACKAGES[@]}"
            ;;
        dnf) "${ELEVATE[@]}" dnf install -y -- "${MISSING_PACKAGES[@]}" ;;
        pacman) "${ELEVATE[@]}" pacman -S --needed --noconfirm -- "${MISSING_PACKAGES[@]}" ;;
        zypper) "${ELEVATE[@]}" zypper --non-interactive install -- "${MISSING_PACKAGES[@]}" ;;
    esac
}

python_version_is_supported() {
    command -v python3 >/dev/null 2>&1 &&
        python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'
}

verify_commands() {
    local command_name
    local status=0
    progress 'Verificando los programas requeridos...'
    for command_name in bash python3 ssh sftp; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            printf 'Falta el programa requerido: %s\n' "$command_name" >&2
            status=1
        fi
    done
    if ! python_version_is_supported; then
        printf 'La interfaz necesita Python 3.10 o posterior.\n' >&2
        status=1
    fi
    return "$status"
}

verify_environment() {
    if [[ ! -x "$VENV_PYTHON" ]]; then
        printf 'El entorno privado todavía no existe: %s\n' "$VENV_DIR" >&2
        return 1
    fi
    if ! "$VENV_PYTHON" -c 'import paramiko; import PySide6; import PySide6.QtMultimedia; import gui; import gui.application' 2>/dev/null; then
        printf 'Paramiko, PySide6 o RecalboxGUI no se pueden importar desde el entorno privado.\n' >&2
        return 1
    fi
    printf 'El entorno privado de RecalboxGUI está preparado.\n'
}

if [[ "$PACKAGE_FAMILY" == unknown ]]; then show_manual_requirements; exit 2; fi
case "$PACKAGE_FAMILY" in
    apt) command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1 ;;
    dnf) command -v dnf >/dev/null 2>&1 && command -v rpm >/dev/null 2>&1 ;;
    pacman) command -v pacman >/dev/null 2>&1 ;;
    zypper) command -v zypper >/dev/null 2>&1 && command -v rpm >/dev/null 2>&1 ;;
esac || { printf 'No está disponible el gestor de paquetes esperado.\n' >&2; show_manual_requirements; exit 2; }

progress "Comprobando ${#PACKAGES[@]} paquetes del sistema..."
for package in "${PACKAGES[@]}"; do
    package_installed "$package" || MISSING_PACKAGES+=("$package")
done
if ((${#MISSING_PACKAGES[@]})); then
    printf 'Paquetes del sistema que faltan:\n'; printf '  %s\n' "${MISSING_PACKAGES[@]}"
else
    printf 'Todos los paquetes conocidos están instalados.\n'
fi

if [[ "$ACTION" == check ]]; then
    check_status=0
    ((${#MISSING_PACKAGES[@]} == 0)) || check_status=1
    verify_commands || check_status=1
    verify_environment || check_status=1
    exit "$check_status"
fi

if ((${#MISSING_PACKAGES[@]})); then
    if ((EUID != 0)); then
        command -v sudo >/dev/null 2>&1 || { printf 'Se necesitan privilegios, pero sudo no está disponible.\n' >&2; exit 1; }
        ELEVATE=(sudo)
    fi
    if (( ! ASSUME_YES )); then
        read -r -p '¿Instalar los paquetes del sistema que faltan? [s/N] ' response || exit 1
        [[ "$response" =~ ^([sS]|[sS][iIÍí])$ ]] || { printf 'Instalación cancelada.\n'; exit 0; }
    fi
    install_packages
fi

verify_commands
progress 'Creando o actualizando el entorno privado de Python...'
if [[ ! -x "$VENV_PYTHON" ]]; then python3 -m venv "$VENV_DIR"; fi
"$VENV_PYTHON" -m pip install --upgrade pip
"$VENV_PYTHON" -m pip install -e "$PROJECT_DIR"
# Setuptools puede dejar esta copia temporal junto al código. La metadata
# instalada y necesaria permanece como dist-info dentro de gui/.venv.
cleanup_project_metadata
chmod +x "$SCRIPT_DIR/setup" "$SCRIPT_DIR/recalboxgui" "$SCRIPT_DIR/package"
progress 'Verificando PySide6 y RecalboxGUI...'
verify_environment

progress 'Preparación terminada correctamente.'
printf 'Inicia la aplicación con: %s/recalboxgui\n' "$SCRIPT_DIR"
